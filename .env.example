# ── Backend ─────────────────────────────────────────────────────
APP_SECRET=dev-secret-change-in-production
AUTH_DISABLED=false

# ── MongoDB Atlas ───────────────────────────────────────────────
# Atlas → Database → your cluster → Connect → Drivers
# Copy the hostname (e.g. cluster0.abc12.mongodb.net) into MONGODB_CLUSTER_HOST
MONGODB_CLUSTER_HOST=
MONGODB_USER=your_db_username
MONGODB_PASSWORD=your_db_password
MONGODB_DB_NAME=tracker_app

# Optional: full URI overrides the fields above
# MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/tracker_app?retryWrites=true&w=majority

DATABASE_URL=
